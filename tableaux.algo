Tableau tab[5] en CHAINE

// les valeurs dans le tableau sont accessible par leur indice [n]
["hello","holla","Salam","HI" , "moshi"]
[   0   ,   1   ,   2   ,   3  , 4     ]
de  0          jusqu a    taille - 1

// récupération 
tab[0] renvoie "hello"
tab[2] renvoie "Salam"

// affecter
tab[0] <- "nouvelle valeur"


// --------------------------------------------

CONSTANTE TAILLE de ENTIER <- 100000
Tableau Scores[TAILLE] en Entier

variable i en Entier

i <- 0

TANTQUE  i < TAILLE FAIRE

		Ecrire("Entrez une valeur pour l'emplacement " + i)
        tab[i] <- lire()
        i = i + 1

	FINTANTQUE

i <- 0
TANTQUE i < TAILLE FAIRE

		Ecrire(tab[i]) tab[4]

        i = i + 1
	FINTANTQUE

// ---------------------------------------

Écrire un algorithme qui saisit 6 entiers 
et les stocke dans un tableau, 
puis affiche le contenu de ce tableau une fois qu’il est rempli.

Tableau tab[6] en Entier

variable i en Entier <- 0
variable input en Entier

TANTQUE i < 6 FAIRE
		Ecrire("Entrez une valeur")
        lire(input)

        tab[i] <- input
        i = i + 1
	FINTANTQUE

i <- 0
TANTQUE i < 6 FAIRE
		Ecrire(tab[i])
        i = i + 1
	FINTANTQUE

// --------------------------------

Tableau tab[10] en Entier

variable i en Entier <- 1
variable value en Entier <- 2


TANTQUE  i < 10 FAIRE
		tab[i] <- value * 2

        i = i + 1
        value = value * 2
	FINTANTQUE

i <- 0
TANTQUE i < 10 FAIRE
		Ecrire(tab[i])

        i = i + 1
	FINTANTQUE 
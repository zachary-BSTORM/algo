    // ------------------------------------------------

    // jeu du plus ou moins 
    // on travaille avec un nombreMystère aléatoire (random())
    // demandez à l utilisateur une valeur 
    // indiquer si la valeur est plus petite ou plus grande que le nombreMystère


  Algorithme JeuDuNombreMystère

    variable mysteryNumber en Entier <- random(1 , 100) // 50
    variable inputUser en Entier


    DEBUT

        FAIRE
            FAIRE
                Ecrire("Entrez une valeur entre 1 et 100")
                lire(inputUser) // 25
            TANTQUE inputUser < 1 OU inputUser > 100

            Si nombreMystère < inputUser Alors
                Ecrire("La valeur est plus petite")
            SinonSi nombreMystère > inputUser Alors
                Ecrire("La valeur est plus grande")
            Sinon
                Ecrire("Bravo vous avez trouvé le nombre mystère")
            FinSi

        TANTQUE inputUser != nombreMystère

	
    FIN  

// -------------------------------

variable mystery en Entier
variable inputUser en Entier
variable win en Booléen <- faux


DEBUT

    TANTQUE NON(win) FAIRE
		FAIRE
            Ecrire("Entrez une valeur entre 1 et 100")
            lire(inputUser) // 25
        TANTQUE inputUser < 1 OU inputUser > 100
        
        Si nombreMystère < inputUser Alors
            Ecrire("La valeur est plus petite")
            SinonSi nombreMystère > inputUser Alors
                Ecrire("La valeur est plus grande")
                Sinon
                    Ecrire("Bravo vous avez trouvé le nombre mystère")
                    win <- vrai
        FinSi


	FINTANTQUE

    Ecrire("Merci à bientot")

FIN

// ---------------------------------------------------------
À l’aide d’une boucle, afficher la table de multiplication par 2.
Ensuite, tester votre algorithme avec Flowgorithm.


Algorithme TableDe2

variable compteur en Entier

compteur <- 1

TANTQUE compteur < 11 FAIRE
		Ecrire(compteur + " * 2 = " + (compteur * 2) )
        compteur = compteur + 1
	FINTANTQUE

    FAIRE 
        Ecrire(compteur + " * 2 = " + (compteur * 2) )
        compteur = compteur + 1
    TANTQUE compteur < 11



// ---------------------------------------------------------
À l’aide de deux boucles, afficher les tables de multiplication
de 1 à 9. Ensuite, tester votre algorithme avec Flowgorithm.

variable i , j en Entier

i <- 1

TANTQUE i < 11 FAIRE 
		
        j <- 1   
        TANTQUE  j < 11 FAIRE
		    Ecrire(i + " * " + j + " = " + (i * j)) * 1 = 2 // i = 2 | j = 1
            j = j + 1
	    FINTANTQUE

        i = i + 1 
FINTANTQUE
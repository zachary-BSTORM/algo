// Année bissextile 
// Réaliser un petit algorithme qui sur base d’une année donnée va déterminer s’il s’agit
// d’une année bissextile. 
// Une année est bissextile 
// si elle est divisible par 4, mais non divisible par 100. 
// Ou si elle est divisible par 400.


Algorithme AnBissextile

variable year en Entier

DEBUT 
Ecrire("Entrez une année : ")
lire(year)

 est bissextile si year est divisible par 4, et year non divisible par 100. 
// Ou si year est divisible par 400.


SI (year % 4 = 0) ET (year % 100 != 0) ALORS
		Ecrire("bissextile")
    SINONSI (year % 400 = 0) ALORS
		Ecrire("bissextile")
	SINON
		Ecrire("non-bissextile")
	FINSI

FIN

DEBUT 
SI ((year % 4 = 0) ET (year % 100 != 0)) OU (year % 400 = 0) ALORS
		Ecrire("bissextile")
	SINON
		Ecrire("non-bissextile")
	FINSI

FIN



// ------------------------------------------------
Lanceur de balles de tennis (Pseudo-Code)
Réaliser l’algorithme d’un lanceur de balles de tennis. 
Ce lanceur possède deux états :
    – prêt : permet de savoir si le tennisman est prêt. Il ne faut pas lancer de balles dans le cas co
    – panierVide : permet de savoir s’il y a encore des balles disponibles
Le lanceur de balle possède l’opération « lancerBalle » 
qui vous l’aurez compris, permet de lancer une balle.

Algorithme LanceurDeBalles

variable pret en Booléen <- faux
variable panierVide en Booléen <- faux


variable stockBalles en Entier
variable joueurEnPosition en CHAINE

DEBUT 
Ecrire("Combien de balles avez-vous mis dans la machine ? ")
lire(stockBalles)

SI stockBalles > 0 ALORS
		panierVide <- faux
	FINSI

Ecrire("Etes vous en position ? y - n")
lire(joueurEnPosition)
SI joueurEnPosition = "y" ALORS
    pret <- vrai
	FINSI

SI NON panierVide ET pret ALORS
		Ecrire("On lance les balles")
        SINON 
            Ecrire("Prévenez nous quand vous êtes prêt !")
	FINSI
FIN


on récupère le nombre de balles
si on à au moins une balle on peut définir que le panier n'est pas vide
on demande à l'utilisateur si il est pret
si l'utilisateur est prêt et que le panier n'est pas vide
on lance les balles

/---------------------------------------------

Distributeur de boissons (Pseudo-Code)
Réaliser l’algorithme d’un distributeur de boissons. 
Ce dernier propose plusieurs boissons et 
l’utilisateur choisit celle qu’il désire en entrant le numéro correspondant. 
Ne pas oublier de vérifier s’il y a encore des boissons en stock

Algorithme Distributeurs

variable choice en CHAINE

variable coca en Entier <- 5
variable fanta en Entier <- 5
variable eau en Entier <- 5

DEBUT
	Ecrire("Choisissez votre boisson :")
    SI coca > 0 ALORS
        Ecrire("Coca - 1")
	FINSI
    Ecrire("Fanta - 2")
    Ecrire("Eau - 3")

    lire(choice)

    SELONQUE choice VAUT
        "1" : SI coca > 0 ALORS
                Ecrire("Voici votre coca")
                coca = coca - 1 (coca -= 1)
              SINON
                   Ecrire("Cette boisson n'est pas disponible")
              FINSI
        "2" : SI fanta > 0 ALORS
                Ecrire("Voici votre fanta")
                fanta = fanta - 1
              SINON
                   Ecrire("Cette boisson n'est pas disponible")
              FINSI
        "3" : SI eau > 0 ALORS
                Ecrire("Voici votre eau")
                eau =  eau - 1
              SINON
                   Ecrire("Cette boisson n'est pas disponible")
              FINSI

        "default" : Ecrire("Cette boisson n'existe pas")
FIN

// ------------------------------------------------------------------


// Calculatrice

Algorithme Calculatrice

// déclaration
variable nb1 , nb2 , resultat en Entier
variable operator en CHAINE

DEBUT
// récupération
Ecrire("Entrez le premier nombre :")
lire(nb1)

Ecrire("Entrez un opérateur ( + - * / ) :")
lire(operator)

Ecrire("Entrez le deuxième nombre :")
lire(nb2)

// execution
SELONQUE operator VAUT
"+" : resultat <- nb1 + nb2
"-" : resultat <- nb1 - nb2
"*" : resultat <- nb1 * nb2
"/" : Si nb2 != 0 Alors
		resultat <- nb1 / nb2
        Sinon
            Ecrire("La division par zero n'est pas possible")


// Resultat attendu
Ecrire("Le resultat de " + nb1 + operator + nb2 + " = " resultat)

FIN

// ---------------------------------------------------
Convertisseur 
Réalisez un algorithme utilisant le convertisseur de secondes, 
il reçoit deux durées (jours, heures, minutes et secondes) 
et calcule la différence entre ces dernières.

variable jours1,heures1,minutes1,secondes1 en Entier
variable jours2,heures2,minutes2,secondes2 en Entier

variable dureeSecondes1 en Entier
variable dureeSecondes2 en Entier

variable diffSecondes en Entier

variable resteSecondes en Entier

variable diffJours,diffHeures,diffMinutes,diffSecondes2 en Entier

DEBUT
	// récupération des valeurs--------------------------------
    Ecrire("Entrez la valeur en jours pour la première durée")
    lire(jours1)

    Ecrire("Entrez la valeur en heures pour la première durée")
    lire(heures1)

    Ecrire("Entrez la valeur en minutes pour la première durée")
    lire(minutes1)

    Ecrire("Entrez la valeur en secondes pour la première durée")
    lire(secondes1)



    Ecrire("Entrez la valeur en jours pour la deuxième durée")
    lire(jours2)

    Ecrire("Entrez la valeur en heures pour la deuxième durée")
    lire(heures2)

    Ecrire("Entrez la valeur en minutes pour la deuxième durée")
    lire(minutes2)

    Ecrire("Entrez la valeur en secondes pour la deuxième durée")
    lire(secondes2)


    // Execution de la logique

    // conversion dans une valeur commune --------------------------------
    dureeSecondes1 <- (jours1 * 86400) + (heures1 * 3600) + (minutes1 * 60) + secondes1
    dureeSecondes2 <- (jours2 * 86400) + (heures2 * 3600) + (minutes2 * 60) + secondes2

    // vérification de la plus grande valeur--------------------------------
    Si dureeSecondes1 >= dureeSecondes2 Alors
		diffSecondes <- dureeSecondes1 - dureeSecondes2
	Sinon
		diffSecondes <- dureeSecondes2 - dureeSecondes1
	FinSi

// récupération des valeurs du résultat --------------------------------

    diffJours <- diffSecondes DIV 86400
    resteSecondes <- diffSecondes MOD 86400

    diffHeures <- resteSecondes DIV 3600
    resteSecondes resteSecondes MOD 3600

    diffMinutes <- resteSecondes DIV 60

    diffSecondes <- resteSecondes MOD 60


    // resultat attendu--------------------------------
    Ecrire("La différence est de " + diffJours + "j " + diffHeures + "h " + diffMinutes + "m " + diffSecondes + "s")

FIN

// ---------------------------------------------------

"Gestion d'un menu utilisateur :
- pour chaque action on affiche un message 
- le menu contient : 
                    - afficher la liste des utilisateurs ( rien à récupérer )
                    - afficher un utilisateur par son id ( récupérer l'id et l'afficher)
                    - modifier un utilisateur ( récupérer id , email , password)
                    - supprimer un utilisateur ( récupérer l'id )"


variable choice en Entier
variable id en Entier
variable email en CHAINE
variable password en CHAINE

Ecrire("Menu")
Ecrire("Afficher la liste - 1")
Ecrire("Afficher un utilisateur - 2")
Ecrire("Modifier un utilisateur - 3")
Ecrire("Supprimer un utilisateur - 4")

Ecrire("Faites votre choix :")
lire(choice)

SELONQUE choice VAUT
1 : Ecrire("Affichage de la liste")

2 : 
    Ecrire("Entrez l'id de l'utilisateur à afficher")
    lire(id)
    Ecrire("Voici le détail de l'utilisateur " + id)

3 : 
    Ecrire("Entrez l'id de l'utilisateur à modifier")
    lire(id)
    Ecrire("Entrez le nouvel email")
    lire(email)
    Ecrire("Entrez le nouveau mot de passe")
    lire(password)

    Ecrire("L'utilisateur " + id + "à bien été modifié")

4 : 
    Ecrire("Entrez l'id de l'utilisateur à modifier")
    lire(id)
    Ecrire("L'utilisateur " + id + " à bien été supprimé")

// ------------------------------------------------------------------

variable i en Entier <- 0


TANTQUE i < 10 FAIRE
		Ecrire(i)
        i = i + 1
	FINTANTQUE


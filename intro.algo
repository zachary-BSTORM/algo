 Variable A, B, C, D, E : Entier
DEBUT
	
    A ← 8 MOD 3                     // 2
    B ← 4 + A                       // 6
    C ← B * A                       // 12
    D ← (C – A) * B                 // 60
    E ← ((A + 7) * (D DIV A)) * 0   // 0
        ( (9)  ) * ( 30 ) * 0
Fin


// ----------------------------------------

Algorithme ConvertisseurSecondes

// heure   : 3600
// jour    : 86400

variable secondesInput en Entier // 60

variable jours , heures , minutes , secondes en Entier


DEBUT
	// code à implémenter

    lire(secondesInput) // 10000


    secondes <- secondesInput MOD 60 

    minutes <- secondesInput DIV 60 


    heures <- minutes DIV 60  
    minutes <- minutes MOD 60 


    jours  < - heures DIV 24 
    heure <- heures MOD 24 


    Ecrire(secondesInput + "s Donne " + 
            jours + "j " + 
            heures + "h " + 
            minutes + "m " +  
            secondes + "s" )  
        //    4561 s donne 0 j 1h 16m 1s
FIN
variable a en Entier // 5
variable b en Entier // 4

DEBUT
	a <- a + b 
    // a = 9
    // b = 4

    b <- a - b
    // b = 5
    // a = 9

    a <- a - b
    // a = 4
    // b = 5

    Ecrire(a) 
    Ecrire(b) 
FIN

